{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qrosetta.cli/start@0: the envelope's data",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "finished_jobs": {
      "type": "object",
      "description": "the finished-job settings `start` gives the API: [lifecycle] jobs_kept, job_storage, job_memory and job_retention of the config file, overridden by QROSETTA_JOB_MAX_KEPT, QROSETTA_JOB_SPILL_MAX_MIB, QROSETTA_JOB_MEMORY_MAX_MIB and QROSETTA_JOB_TTL_SEC",
      "properties": {
        "jobs_kept": {
          "type": "integer"
        },
        "job_storage_mib": {
          "type": "integer"
        },
        "job_memory_mib": {
          "type": "integer"
        },
        "job_retention_sec": {
          "type": "integer"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "jobs_kept",
        "job_storage_mib",
        "job_retention_sec",
        "sources"
      ]
    }
  }
}
