{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qrosetta.cli/status@1: the envelope's data",
  "type": "object",
  "properties": {
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": "string"
    },
    "project_dir": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootless": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "version",
        "rootless"
      ]
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "backend": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "compose_service": {
            "type": "string"
          },
          "container": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "running",
              "stopped",
              "not created"
            ]
          },
          "memory_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "limit_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "image": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "missing",
                  "pulled",
                  "pulled-other",
                  "loaded",
                  "built",
                  "unknown"
                ]
              },
              "ref": {
                "type": "string"
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "git_sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "release": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "ref",
              "digest",
              "image_id",
              "git_sha",
              "release"
            ],
            "description": "The image now under the service's tag, which start uses."
          },
          "container_image": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "state": {
                "enum": [
                  "missing",
                  "pulled",
                  "pulled-other",
                  "loaded",
                  "built",
                  "unknown"
                ]
              },
              "ref": {
                "type": "string"
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "image_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "git_sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "release": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "current": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "state",
              "ref",
              "digest",
              "image_id",
              "git_sha",
              "release",
              "current"
            ],
            "description": "The image the service's container was created from (null without a container); current: whether it is the image now under the tag in image, null when the engine does not report it."
          },
          "config_current": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the container's compose config hash equals the one `compose config --hash` gives its service under the environment `start` uses; null without a container or when either hash is unknown."
          }
        },
        "required": [
          "id",
          "backend",
          "version",
          "kind",
          "compose_service",
          "container",
          "state",
          "memory_bytes",
          "limit_bytes",
          "image"
        ]
      }
    },
    "cpu_quota": {
      "type": "object",
      "description": "the CPU quota stack setting: off after `start --no-cpu-quota`, with the override compose is given",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "override": {
          "type": [
            "string",
            "null"
          ]
        },
        "override_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "finished_jobs": {
      "type": "object",
      "description": "the finished-job settings `start` gives the API: [lifecycle] jobs_kept, job_storage, job_memory and job_retention of the config file, overridden by QROSETTA_JOB_MAX_KEPT, QROSETTA_JOB_SPILL_MAX_MIB, QROSETTA_JOB_MEMORY_MAX_MIB and QROSETTA_JOB_TTL_SEC",
      "properties": {
        "jobs_kept": {
          "type": "integer"
        },
        "job_storage_mib": {
          "type": "integer"
        },
        "job_memory_mib": {
          "type": "integer"
        },
        "job_retention_sec": {
          "type": "integer"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "jobs_kept",
        "job_storage_mib",
        "job_retention_sec",
        "sources"
      ]
    }
  },
  "required": [
    "url",
    "project",
    "project_dir",
    "mode",
    "engine",
    "services"
  ]
}
