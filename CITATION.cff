cff-version: 1.2.0
message: "If you use QRosetta in academic work, please cite the software using this metadata."
type: software
version: "2.0.0rc4"
title: "Quantum Rosetta (QRosetta): A Reproducible Microservice Platform for Cross-Simulator Benchmarking and Agreement Analysis"
authors:
  - family-names: Sarker
    given-names: Shaswato
    orcid: "https://orcid.org/0000-0001-7066-2104"
    affiliation: "University of Jyväskylä"
  - family-names: Haghparast
    given-names: Majid
    orcid: "https://orcid.org/0000-0003-3427-5961"
    affiliation: "University of Jyväskylä"
  - family-names: Mikkonen
    given-names: Tommi
    orcid: "https://orcid.org/0000-0002-8540-9918"
    affiliation: "University of Jyväskylä"
abstract: >-
  QRosetta is a microservice platform for running one OpenQASM 2.0 circuit across
  heterogeneous quantum simulator backends and comparing their resource use,
  endpoint semantics, raw outputs, and pairwise agreement under a common runner
  contract.
keywords:
  - quantum computing
  - quantum simulation
  - benchmarking
  - reproducibility
  - OpenQASM
  - microservices
license: Apache-2.0
repository-code: "https://github.com/SeQuSoS-Project/QRosetta"
