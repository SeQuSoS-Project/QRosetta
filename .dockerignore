# Build context exclusions: credentials, host virtualenvs, caches and databases that no image may
# carry, and directories no Dockerfile copies. test_build_context.py checks the patterns.
.git
.github
**/.env
**/.env.*
**/*.env
**/*openrc*
**/*.pem
**/*.key
**/secrets
kubeconfig
.kube
CLAUDE.md
**/CLAUDE.md
docker-compose.override.yml
.venv
**/.venv
**/__pycache__
**/.pytest_cache
**/*.pyc
**/.coverage
**/.coverage.*
**/htmlcov
**/coverage.xml
**/.mypy_cache
**/.ruff_cache

# Databases, saved reports and job files of a host run of the API or its tests.
**/data
**/qa_rosetta.db
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite3
.vscode
.claude
latex
**/export
**/experiments
# Build configuration of the page (scripts/build_css.sh, scripts/check_frontend_types.sh), not served.
rosetta-api/static/tailwind.config.js
rosetta-api/static/tsconfig.json
docs
examples

# setuptools output from a host `pip install ./shared`: setuptools copies sources over an
# existing build/lib but never removes files deleted from the sources, so images could ship them.
**/build
**/*.egg-info

# npm installs of the type checker and Tailwind (scripts/check_frontend_types.sh, build_css.sh)
# land in rosetta-api/static/node_modules, which both nginx and the API serve as files.
**/node_modules
