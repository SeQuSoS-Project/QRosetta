DATABASE_URL="postgresql://username:password@host:port/database"
S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY"
S3_SECRET_KEY="YOUR_S3_SECRET_KEY"
S3_BUCKET_NAME="YOUR_S3_BUCKET_NAME"

GCP_PROJECT_ID="YOUR_GCP_PROJECT_ID"
GCP_REGION="us-central1"

# Comma-separated frontend origins allowed by CORS. http://localhost and
# http://127.0.0.1 are always permitted for local development; any other deployed
# frontend origin (e.g. the Rahti/public URL) must be listed here or the browser
# will block requests to the API. Leave empty for local-only use.
CORS_ALLOW_ORIGINS=""
