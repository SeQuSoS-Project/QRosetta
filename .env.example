DATABASE_URL="postgresql://username:password@host:port/database"
S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY"
S3_SECRET_KEY="YOUR_S3_SECRET_KEY"
S3_BUCKET_NAME="YOUR_S3_BUCKET_NAME"

# JWT signing key. Required whenever EXECUTION_MODE is not "local" — the API
# refuses to start without it. Generate one with: openssl rand -base64 48
# Left empty locally, a random key is generated per process and sessions end on restart.
SECRET_KEY=""

# Shared by the Cloud Run frontend and the API (rosetta-secrets on Rahti). The API trusts
# the frontend's client-address header only on requests carrying it. openssl rand -hex 32
QROSETTA_PROXY_TOKEN=""

GCP_PROJECT_ID="YOUR_GCP_PROJECT_ID"
GCP_REGION="us-central1"

# Comma-separated frontend origins allowed by CORS. http://localhost and
# http://127.0.0.1 are always permitted for local development; any other deployed
# frontend origin (e.g. the Rahti/public URL) must be listed here or the browser
# will block requests to the API. Leave empty for local-only use.
CORS_ALLOW_ORIGINS=""

# Host address and port docker compose publishes nginx on. The default reaches only this
# machine. "0.0.0.0:8080" publishes on every IPv4 interface; do that only on a trusted
# network, since local mode lets any client skip the circuit-size and experiment limits.
QROSETTA_HTTP_BIND="127.0.0.1:8080"
